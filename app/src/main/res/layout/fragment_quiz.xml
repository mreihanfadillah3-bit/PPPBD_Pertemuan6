<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    tools:context=".QuizFragment">

    <!-- Gambar Placeholder Empty State Quiz -->
    <ImageView
        android:id="@+id/img_quiz_empty"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:contentDescription="@string/cd_quiz_empty"
        android:src="@drawable/ic_quiz_empty" />

    <TextView
        android:id="@+id/tv_quiz_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/quiz_empty_title"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_quiz_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="@string/quiz_empty_subtitle"
        android:textColor="#757575"
        android:textSize="14sp" />

</LinearLayout>
